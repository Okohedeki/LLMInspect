# Copy to brainscan.env (not committed) to set this machine's defaults for scripts/run.sh.

# A local Hugging Face snapshot (WSL path), a repo id, or ollama:<tag>.
BRAINSCAN_MODEL=/mnt/h/path/to/models--Qwen--Qwen3.5-9B/snapshots/<hash>

# Reasoning models: on, off, or default (the chat template's own default).
BRAINSCAN_THINKING=default
